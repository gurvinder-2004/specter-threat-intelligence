# ─────────────────────────────────────────────────────────────────────────────
# SPECTER x AEGIS — Environment Configuration Template
# Copy this file to .env and populate your respective keys.
# DO NOT commit your .env file to public version control!
# ─────────────────────────────────────────────────────────────────────────────

# ─── Graph Database (Neo4j) ─────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=specter_pass

# ─── Task Queue & Cache (Redis) ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Threat Intelligence Feeds & Enrichment APIs ───────────────────────────
# AlienVault OTX: https://otx.alienvault.com
OTX_API_KEY=your_otx_api_key_here

# VirusTotal v3 API: https://www.virustotal.com
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Shodan API: https://account.shodan.io
SHODAN_API_KEY=your_shodan_api_key_here

# ─── LLM Summarizer Layer ("groq" or "ollama") ──────────────────────────────
LLM_PROVIDER=groq

# Groq Cloud (Ultra-fast cloud inference, free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local, offline inference)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b

# ─── SOAR & Real-Time Alerting Webhooks ─────────────────────────────────────
# Slack incoming webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Discord channel incoming webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Discord Application Public Key (Required for interactive button verification)
# Found at: Discord Developer Portal -> Applications -> General Information
DISCORD_PUBLIC_KEY=your_discord_app_public_key_hex

# ─── IOC Confidence Half-Life Decay Engine ──────────────────────────────────
# Daily decay percentage (e.g. 0.05 = 5% decay per day)
IP_DECAY_RATE=0.05
DOMAIN_DECAY_RATE=0.03
HASH_DECAY_RATE=0.01

# Confidence score below which an IOC is marked as archived
ARCHIVE_THRESHOLD=30

# ─── AEGIS Endpoint Telemetry Bridge ────────────────────────────────────────
# URL used by the AEGIS endpoint to reach SPECTER backend
SPECTER_API_URL=http://localhost:8000
