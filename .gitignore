# ─────────────────────────────────────────────────────────────────────────────
# SPECTER x AEGIS — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── Secrets & Environment Variables (CRITICAL: DO NOT REMOVE) ──────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
credentials.json
secrets/

# ─── Python / Bytecode ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual Environments ───────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ─── Node / React / Vite Frontend ───────────────────────────────────────────
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/dist-ssr/
frontend/*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Celery & Redis Runtime Artifacts ────────────────────────────────────────
celerybeat-schedule
celerybeat.pid
*.dump
dump.rdb

# ─── Dynamic Runtime Logs & Evidence Artifacts ──────────────────────────────
*.log
logs/
evidence/
aegis_test_victims/
victims/
*.wncry
*.lockbit

# ─── OS Specific Junk Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ─── IDE & Editor Configurations ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
